@page "/calendars"

<PageTitle>Calendars</PageTitle>

<h1>Calendar</h1>

<div class="row mb-3">
    <div class="col">
        <label class="form-label">Service</label>
        <InputSelect class="form-select"
                     Value="selectedCalendarId"
                     ValueExpression="@(() => selectedCalendarId)"
                     ValueChanged="@(async (int value) => await OnCalendarChanged(value))">
            @foreach (var calendar in calendars)
            {
                <option value="@calendar.Id">@calendar.Name</option>
            }
        </InputSelect>
    </div>
</div>

<SfSchedule @ref="scheduler" TValue="AppointmentDto" @bind-SelectedDate="@currentDate"@bind-CurrentView="@currentView"
            AllowOverlap="false" AllowResizing="false" AllowKeyboardInteraction="false" AllowClipboard="false"
            ShowWeekend="true" ShowWeekNumber="true"
            Height="650px" FirstDayOfWeek="1" DateFormat="yyyy/MM/dd">
    <ScheduleTemplates>
        <EditorTemplate>
            <SchedulerEditorTemplateComponent Appointment="@(context as AppointmentDto)" Services="services" />
        </EditorTemplate>
        <EditorFooterTemplate>
            <button class="btn btn-primary" @onclick="@(() => OnSave(context as AppointmentDto))">Save</button>
            <button class="btn btn-outline-secondary" @onclick="OnClose">Close</button>
            @if ((context as AppointmentDto).Id != 0)
            {
                <button class="btn btn-outline-danger ms-1" @onclick="@(() => OnDelete((context as AppointmentDto).Id))">Delete</button>
            }
        </EditorFooterTemplate>
    </ScheduleTemplates>
    <ScheduleEventSettings DataSource="appointments">
        <Template>
            <div>Subject: Subject</div>
            <div>@((context as AppointmentDto).StartTime?.ToString("hh:mm")) - @((context as AppointmentDto).EndTime?.ToString("hh:mm"))</div>
        </Template>
    </ScheduleEventSettings>
    <ScheduleEvents TValue="AppointmentDto" OnCellClick="OnCellClick" />
    <ScheduleWorkHours Highlight="true" Start="@currentCalendarStarTime" End="@currentCalendarEndTime" />
    <ScheduleViews>
        <ScheduleView Option="View.Day" />
        <ScheduleView Option="View.Week" />
        <ScheduleView Option="View.WorkWeek" />
        <ScheduleView Option="View.Month" />
        <ScheduleView Option="View.Agenda" />
    </ScheduleViews>
</SfSchedule>

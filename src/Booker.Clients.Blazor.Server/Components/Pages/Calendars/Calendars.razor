@page "/calendars"

<PageTitle>Calendars</PageTitle>

<h1>Calendars</h1>

<div class="row mb-3">
    <div class="col">
        <a class="btn btn-primary" href="calendars/add">Add new calendar</a>
    </div>
</div>

@if (calendars is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Start time</th>
                <th>End time</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var calendar in calendars)
            {
                <tr>
                    <td>@calendar.Name</td>
                    <td>@calendar.StartTime</td>
                    <td>@calendar.EndTime</td>
@*                     <td>
                        <button class="btn btn-outline-danger" @onclick="@(() => OnDelete(calendar.Id))">Delete</button>
                        <a href="/services/edit/@calendar.Id" class="btn btn-outline-secondary">Update</a>
                    </td> *@
                </tr>
            }
        </tbody>
    </table>
}
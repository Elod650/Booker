@page "/calendars/customers/{CalendarId:int}"

<PageTitle>Manage customers</PageTitle>

<h1>Manage customers</h1>

<div class="row mb-3">
    <div class="col-8">
        <InputText @bind-Value="emailToAdd" class="form-control" placeholder="Customer's email" />
    </div>
    <div class="col-4">
        <button class="btn btn-primary" @onclick="AddCustomerToCalendar">Add customer</button>
    </div>
</div>

<div class="row">
    <div class="col">
        @if (users.Count == 0)
        {
            <p>No customers found for this calendar.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in users)
                    {
                        <tr>
                            <td>@user.FirstName @user.LastName</td>
                            <td>@user.Email</td>
                            <td>
                                <button class="btn btn-outline-danger" @onclick="@(() => OnDelete(user.Email))">Remove user</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<ConfirmationModal IsOpen="@this.isDeleteModalOpen"
                   Title="Delete Service"
                   Message="Are you sure you want to delete this service?"
                   OnConfirm="this.OnDeleteConfirmed"
                   OnCancel="this.OnDeleteCancelled" />

@code {
    [Parameter]
    public int CalendarId { get; set; }

    private string emailToAdd;
    private List<UserDto> users = new();

    private bool isDeleteModalOpen;
    private string? userEmailToRemove;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            users = await CalendarApiCaller.GetCustomersForCalendar(CalendarId);
        }
        catch (ApiCallerException ex)
        {
            Log.Warning($"An invalied api call occured in {nameof(CalendarCustomers)} during {nameof(OnInitializedAsync)}. Error message: {ex.ApiResponseMessage}");
            await JSRuntime.ErrorToast(ex.ApiResponseMessage ?? "Api returned error");
        }
        catch (Exception ex)
        {
            Log.Error(ex, $"An error occurred in {nameof(CalendarCustomers)} during {nameof(OnInitializedAsync)}");
            await JSRuntime.ErrorToast("An error occured during the loading of the customers");
        }
    }

    private async Task AddCustomerToCalendar()
    {
        try
        {
            var request = new AddCustomerToCalendarRequest
            {
                CalendarId = CalendarId,
                CustomerEmail = emailToAdd
            };

            var response = await CalendarApiCaller.AddCustomerToCalendar(request);

            if (response is not null)
            {
                await JSRuntime.SuccessToast("Custemer added to calendar");
                return;
            }

            await JSRuntime.ErrorToast(response);
        }
        catch (ApiCallerException ex)
        {
            Log.Warning($"An invalied api call occured in {nameof(CalendarCustomers)} during {nameof(AddCustomerToCalendar)}. Error message: {ex.ApiResponseMessage}");
            await JSRuntime.ErrorToast(ex.ApiResponseMessage ?? "Api returned error");
        }
        catch (Exception ex)
        {
            Log.Error(ex, $"An error occurred in {nameof(CalendarCustomers)} during {nameof(AddCustomerToCalendar)}");
            await JSRuntime.ErrorToast("An error occured during the addition of the customer to calendar");
        }
    }

    private void OnDelete(string email)
    {
        userEmailToRemove = email;
        isDeleteModalOpen = true;
    }

    private async Task OnDeleteConfirmed()
    {
        isDeleteModalOpen = false;
        if (userEmailToRemove is null)
        {
            return;
        }

        try
        {
            var request = new RemoveCustomerFromCalendarRequest
            {
                CalendarId = CalendarId,
                CustomerEmail = userEmailToRemove
            };

            var result = await CalendarApiCaller.RemoveCustomerFromCalendarAsync(request);

            if (result is not null)
            {
                await JSRuntime.ErrorToast(result);
                return;
            }

            users = await CalendarApiCaller.GetCustomersForCalendar(CalendarId);

            await JSRuntime.SuccessToast("User removed from calendar");
        }
        catch (Exception ex)
        {
            Log.Error(ex, $"An error occurred in {nameof(Calendars)} during {nameof(OnDeleteConfirmed)}");
            await JSRuntime.ErrorToast("An error occured during the delete of the calendar");
        }
        finally
        {
            userEmailToRemove = null;
        }
    }

    private void OnDeleteCancelled()
    {
        isDeleteModalOpen = false;
        userEmailToRemove = null;
    }
}

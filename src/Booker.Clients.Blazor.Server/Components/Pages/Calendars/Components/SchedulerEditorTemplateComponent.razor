<div class="container">
    @if(!string.IsNullOrWhiteSpace(Appointment.BookingUser))
    {
        <div class="row mb-3">
            <label><b>Booked for:</b> @Appointment.BookingUser</label>
        </div>
    }    
    <div class="row mb-3">
        <div class="col">
            <label class="form-label">Service</label>
            <InputSelect class="form-select"
                         Value="Appointment.ServiceId"
                         ValueExpression="@(() => Appointment.ServiceId)"
                         ValueChanged="@(async (int value) => await OnServiceChange(value))">
                @foreach (var service in Services)
                {
                    <option value="@service.Id">@service.Name</option>
                }
            </InputSelect>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col">
            <label class="form-label">Start time</label>
            <InputDate class="form-control" disabled
                       Type="InputDateType.DateTimeLocal"
                       @bind-Value="Appointment.StartTime" />
        </div>
    </div>
    <div class="row mb-3">
        <div class="col">
            <label class="form-label">End time</label>
            <InputDate class="form-control" disabled
                       Type="InputDateType.DateTimeLocal"
                       @bind-Value="@Appointment.EndTime" />
        </div>
    </div>
</div>
